{
  "name": "copilot-hud",
  "displayName": "Copilot HUD",
  "description": "Status bar HUD for GitHub Copilot quota usage: % bars, remaining, reset date, cycle pace.",
  "version": "0.1.0",
  "publisher": "varoindustries",
  "repository": { "type": "git", "url": "https://github.com/VAROIndustries/VSCodeCoPilotHUD" },
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "main": "extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "copilotHud.open", "title": "Copilot HUD: Open Dashboard" },
      { "command": "copilotHud.refresh", "title": "Copilot HUD: Refresh" },
      { "command": "copilotHud.signIn", "title": "Copilot HUD: Sign in to GitHub" }
    ]
  },
  "scripts": { "test": "node test.js" }
}
